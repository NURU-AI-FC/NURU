# Copy to .env (same folder) and fill in the keys you want to use locally.
# .env is ignored by git, so the keys never leave your computer.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
SPITCH_API_KEY=

# Optional: which Claude models answer, and how long long answers think first
NURU_MODEL=claude-opus-5-5
NURU_FAST_MODEL=claude-sonnet-5-5
NURU_EFFORT=low
