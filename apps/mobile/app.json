{
  "expo": {
    "name": "NURU",
    "slug": "nuru",
    "scheme": "nuru",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.nuru.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "NURU uses Face ID to confirm it is you before money moves.",
        "NSMicrophoneUsageDescription": "NURU uses the microphone so you can ask questions about your money by voice.",
        "NSLocationWhenInUseUsageDescription": "NURU uses your location to show the Zenith Bank branches and ATMs nearest to you."
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "app.nuru.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E30613",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#E30613",
          "dark": {
            "backgroundColor": "#5C0008"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "NURU uses the microphone so you can ask questions about your money by voice.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NURU uses your location to show the Zenith Bank branches and ATMs nearest to you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "nuruai",
    "extra": {
      "eas": {
        "projectId": "53254f6f-36d3-4c72-9f50-a26fc64be5f6"
      }
    }
  }
}
