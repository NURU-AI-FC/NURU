# One-off image for moving data to Supabase: runs cmd/dbcopy and exits.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /dbcopy ./cmd/dbcopy

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /dbcopy /dbcopy
USER nonroot
ENTRYPOINT ["/dbcopy"]
